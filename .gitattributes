# What this project is written in, as far as GitHub's language bar is concerned.
#
# Linguist counts every file it recognises, so a handful of build and benchmark
# helpers were being reported as if the player were partly written in Python and
# PowerShell. It is not: the app is TypeScript, Rust, CSS and one HTML entry
# point, and everything excluded below is tooling around it or an experiment
# kept for reference.
#
# `linguist-detectable=false` hides a path from the language statistics ONLY.
# The files stay in the repository, stay in diffs, stay searchable, and keep
# their syntax highlighting - this changes a chart, not the code.

# Build, benchmark and verification helpers. Real code, but not the product.
scripts/**              linguist-detectable=false

# Throwaway spikes, kept because their measurements are cited in the docs.
spike/**                linguist-detectable=false

# Tool configuration living at the root.
*.config.mjs            linguist-detectable=false
*.config.cjs            linguist-detectable=false
*.config.js             linguist-detectable=false

# Generated by Tauri from tauri.conf.json; nobody edits these by hand.
src-tauri/gen/**        linguist-generated=true
