{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-audio-spike",
  "version": "0.1.0",
  "identifier": "dev.nikenmar.nora.spike",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "title": "nora:// spike",
        "width": 1100,
        "height": 800,
        "resizable": true,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=msWebOOUI,msPdfOOUI"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost http://nora.localhost nora:",
        "media-src": "'self' http://nora.localhost nora: blob: data:",
        "img-src": "'self' data: blob:"
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
