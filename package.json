{
  "name": "nemora",
  "version": "1.0.7-stable",
  "type": "module",
  "description": "Nemora - music player by nikenmar (CMR)",
  "contributors": [
    {
      "name": "nikenmar",
      "url": "https://github.com/Nikenmar"
    }
  ],
  "keywords": [
    "music",
    "tauri",
    "react",
    "typescript",
    "music-player",
    "lyrics",
    "windows",
    "desktop"
  ],
  "author": {
    "name": "nikenmar",
    "url": "https://github.com/Nikenmar"
  },
  "homepage": "https://github.com/Nikenmar/Nemora",
  "urls": {
    "website_url": "https://github.com/Nikenmar/Nemora"
  },
  "bugs": {
    "url": "https://github.com/Nikenmar/Nemora/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nikenmar/Nemora"
  },
  "appPreferences": {
    "metadataEditingSupportedExtensions": [
      "mp3"
    ],
    "removeReactStrictMode": false,
    "showSongIdInsteadOfSongYear": false,
    "supportedMusicExtensions": [
      "mp3",
      "wav",
      "ogg",
      "aac",
      "m4r",
      "m4a",
      "opus",
      "flac"
    ]
  },
  "overrides": {
    "phin": "^3.7.1",
    "cross-spawn": "^6.0.5",
    "node-vibrant": {
      "@vibrant/image-node": {
        "@jimp/types": {
          "@jimp/jpeg": {
            "jpeg-js": "^0.4.4"
          }
        }
      }
    }
  },
  "scripts": {
    "test": "jest --collect-coverage",
    "check-types": "tsc --noEmit",
    "husky-test": "npm run prettier-check && npm run test",
    "prepare": "husky install",
    "prettier-check": "prettier --check .",
    "prettier-write": "prettier --write .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix --ext .ts,.tsx",
    "lint-save-results": "eslint . --ext .ts,.tsx -o ./lint_results.txt",
    "eslint-inspector": "npx @eslint/config-inspector@latest",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "verify": "powershell -ExecutionPolicy Bypass -File scripts/verify-release.ps1",
    "typecheck": "npm run typecheck:web",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:renderer:dev": "vite --config vite.tauri.config.ts",
    "tauri:renderer:build": "vite build --config vite.tauri.config.ts",
    "port-check": "node scripts/port-check.mjs",
    "port-check:baseline": "node scripts/port-check.mjs --update-baseline",
    "dev": "tauri dev",
    "build": "tauri build"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@neos21/detect-chinese": "^0.0.2",
    "@sglkc/kuroshiro": "^1.0.1",
    "@sglkc/kuroshiro-analyzer-kuromoji": "^1.0.1",
    "@tanstack/react-query": "^5.52.2",
    "@tanstack/react-query-devtools": "^5.52.2",
    "@tanstack/react-store": "^0.7.0",
    "@tanstack/react-virtual": "^3.10.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-log": "^2",
    "@tauri-apps/plugin-os": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "any-ascii": "^0.3.3",
    "buffer": "^5.7.1",
    "didyoumean2": "^7.0.2",
    "html-to-image": "^1.11.13",
    "i18next": "^24.2.0",
    "mime": "^4.0.6",
    "music-metadata": "^11.0.0",
    "node-id3": "^0.2.6",
    "node-taglib-sharp": "^6.0.3",
    "node-vibrant": "^4.0.3",
    "pinyin-pro": "^3.26.0",
    "react-i18next": "^15.0.2",
    "react-sortablejs": "^6.1.4",
    "react-virtuoso": "^4.10.4",
    "romaja": "^0.2.9",
    "segmentit": "^2.0.3",
    "sortablejs": "^1.15.7",
    "tailwind-merge": "^2.2.2",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.4",
    "@eslint/eslintrc": "^3.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "@swc/core": "^1.10.16",
    "@tauri-apps/cli": "^2",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.13.4",
    "@types/pinyin": "^2.10.2",
    "@types/react": "^19.0.10",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-dom": "^19.0.4",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.12.0",
    "eslint-import-resolver-typescript": "^4.1.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-promise": "^7.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "globals": "^16.0.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "material-symbols": "^0.29.0",
    "postcss": "^8.4.35",
    "prettier": "^3.2.4",
    "prettier-plugin-tailwindcss": "^0.6.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "satori": "^0.29.0",
    "tailwindcss": "^3.3.2",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.1.1"
  }
}
