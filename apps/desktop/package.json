    "romaja": "^0.2.9",
    "sortablejs": "^1.15.7",
    "tailwind-merge": "^2.2.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "autoprefixer": "^10.4.18",
    "material-symbols": "^0.29.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.3.2",
    "typescript": "^5.8.0",
    "vite": "^6.1.1"
