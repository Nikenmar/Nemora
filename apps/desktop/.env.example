# Build-time configuration, baked into the renderer bundle by Vite.
#
# Copy to `.env` and fill in what you need. Every value is OPTIONAL: a missing
# one disables the feature that uses it rather than breaking the build, so the
# app still compiles and runs with this file untouched.
#
# In CI these come from repository secrets; see .github/workflows/release.yml
# for the mapping. `.env` itself is gitignored and must stay that way.

# Discord Rich Presence. This is the Application ID of YOUR Discord
# application, from discord.com/developers/applications. It also determines the
# name Discord announces and the art assets it can resolve, so the app cannot
# rename itself here: the "nemora_logo" asset has to exist on that application.
MAIN_VITE_DISCORD_CLIENT_ID=

# Last.fm, read only: album and artist descriptions, similar artists and tracks, tag search.
# The API key of YOUR Last.fm API account (last.fm/api/account/create); no shared secret is needed.
MAIN_VITE_LAST_FM_API_KEY=

# Artist biographies and metadata lookups.
MAIN_VITE_GENIUS_API_KEY=

# Encrypts credentials stored in the profile.
#
# CHANGING THIS BREAKS EVERY ALREADY-STORED CREDENTIAL: they were encrypted
# with the old value and cannot be read back with a new one. Pick it once, keep
# it for the life of the app, and keep it identical between local builds and
# CI or a locally built copy will not read a release build's saved logins.
MAIN_VITE_ENCRYPTION_SECRET=

# Crash reporting. Empty disables it.
MAIN_VITE_SENTRY_DSN=
