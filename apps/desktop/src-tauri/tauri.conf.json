{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nemora",
  "version": "../package.json",
  "identifier": "com.cmrdevs.nemora",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5273",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nemora",
        "width": 1280,
        "height": 800,
        "minWidth": 700,
        "minHeight": 500,
        "center": true,
        "backgroundColor": "#212226"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"],
    "licenseFile": "../../../LICENSE"
  }
}
